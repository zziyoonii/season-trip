# 공공데이터포털 일반 인증키(Decoding). 비워두면 data/alerts-snapshot.json 을 써요.
DATA_GO_KR_KEY=
# GA4 측정 ID (예: G-XXXXXXXXXX). 비워두면 GA를 안 붙여요
NEXT_PUBLIC_GA_ID=
# Google AI Studio 에서 발급한 Gemini API 키. 비워두면 대표 행사 목록만 보여줘요.
GEMINI_API_KEY=
# 선택: 다른 모델을 쓰고 싶을 때 (기본 gemini-3.5-flash-lite, 더 정확하게는 gemini-3.8-flash)
GEMINI_MODEL=
